							"mode": "raw",
							"raw": "{\n    \"email\": \"shortpw@example.com\",\n    \"username\": \"shortpwuser\",\n    \"first_name\": \"Short\",\n    \"last_name\": \"Password\",\n    \"phone_number\": \"+27712345681\",\n    \"user_type\": \"customer\",\n    \"password\": \"123\",\n    \"password_confirm\": \"123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/accounts/register/",
							"host": ["{{base_url}}"],
							"path": ["api", "accounts", "register", ""]
						},
						"description": "Attempt to register with a password shorter than 8 characters. Should return 400."
					}
				}
			],
			"description": "User registration tests - success and failure cases."
		},
		{
			"name": "2. JWT Login",
			"item": [
				{
					"name": "Login - Valid Credentials",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response contains access and refresh tokens', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.have.property('access');",
									"    pm.expect(json).to.have.property('refresh');",
									"    pm.expect(json.access).to.be.a('string').and.not.empty;",
									"    pm.expect(json.refresh).to.be.a('string').and.not.empty;",
									"});",
									"",
									"// Save tokens",
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('access_token', json.access);",
									"    pm.collectionVariables.set('refresh_token', json.refresh);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{test_email}}\",\n    \"password\": \"{{test_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/token/",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "token", ""]
						},
						"description": "Login with valid credentials. Returns access and refresh JWT tokens."
					}
				},
