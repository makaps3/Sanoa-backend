{
	"info": {
		"name": "Sanoa - Authentication Tests",
		"description": "Complete authentication test suite for the Sanoa backend API.\n\nCovers: registration, JWT login, token refresh, token verify, get profile, OTP send/verify/resend, and error cases.",
