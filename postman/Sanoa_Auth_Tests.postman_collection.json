	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8101",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refresh_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "test_email",
			"value": "testuser@example.com",
			"type": "string"
		},
		{
			"key": "test_password",
			"value": "TestPass123!",
			"type": "string"
		},
		{
			"key": "otp_code",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Registration",
			"item": [
				{
					"name": "Register - New Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response contains user and tokens', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.have.property('user');",
									"    pm.expect(json).to.have.property('tokens');",
									"    pm.expect(json.tokens).to.have.property('access');",
									"    pm.expect(json.tokens).to.have.property('refresh');",
									"});",
									"",
									"pm.test('User email matches', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.user.email).to.eql(pm.collectionVariables.get('test_email'));",
									"});",
									"",
									"pm.test('User type is customer', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.user.user_type).to.eql('customer');",
									"});",
									"",
									"// Save tokens for later use",
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('access_token', json.tokens.access);",
									"    pm.collectionVariables.set('refresh_token', json.tokens.refresh);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{test_email}}\",\n    \"username\": \"testuser\",\n    \"first_name\": \"Test\",\n    \"last_name\": \"User\",\n    \"phone_number\": \"+27712345678\",\n    \"user_type\": \"customer\",\n    \"password\": \"{{test_password}}\",\n    \"password_confirm\": \"{{test_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/accounts/register/",
							"host": ["{{base_url}}"],
							"path": ["api", "accounts", "register", ""]
						},
						"description": "Register a new customer user. Returns user data and JWT tokens."
					}
				},
				{
					"name": "Register - Duplicate Email (should fail)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 400 Bad Request', function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test('Error mentions email already exists', function () {",
									"    var json = pm.response.json();",
									"    var body = JSON.stringify(json).toLowerCase();",
									"    pm.expect(body).to.include('email');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{test_email}}\",\n    \"username\": \"testuser2\",\n    \"first_name\": \"Test\",\n    \"last_name\": \"Duplicate\",\n    \"phone_number\": \"+27712345679\",\n    \"user_type\": \"customer\",\n    \"password\": \"{{test_password}}\",\n    \"password_confirm\": \"{{test_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/accounts/register/",
							"host": ["{{base_url}}"],
							"path": ["api", "accounts", "register", ""]
