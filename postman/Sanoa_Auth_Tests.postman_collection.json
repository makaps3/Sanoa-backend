						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"incomplete@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/accounts/register/",
							"host": ["{{base_url}}"],
							"path": ["api", "accounts", "register", ""]
