						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{test_email}}\",\n    \"password\": \"WrongPassword999!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/token/",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "token", ""]
						},
						"description": "Attempt login with wrong password. Should return 401."
					}
				},
