						"description": "Attempt to register with missing required fields. Should return 400."
					}
				},
				{
					"name": "Register - Short Password (should fail)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 400 Bad Request', function () {",
