# Reference only. Copy into your deployment's secret store and replace placeholders.
ENVIRONMENT=production
SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
ALLOWED_HOSTS=api.example.com
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sanoa
DB_USER=sanoa
DB_PASSWORD=REPLACE_ME
DB_HOST=postgres
DB_PORT=5432
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
EMAIL_HOST=REPLACE_WITH_SMTP_HOST
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=REPLACE_ME
EMAIL_HOST_PASSWORD=REPLACE_ME
DEFAULT_FROM_EMAIL=Sanoa <noreply@example.com>
EMAIL_REDIRECT_ALL=
EMAIL_TEST_RECIPIENT=
CORS_ALLOWED_ORIGINS=https://admin.example.com
CSRF_TRUSTED_ORIGINS=https://admin.example.com
SECURE_SSL_REDIRECT=True
TRUST_PROXY_SSL_HEADER=False
PAYSTACK_SECRET_KEY=REPLACE_ME
GOOGLE_MAPS_API_KEY=REPLACE_ME
