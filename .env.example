# Environment configuration
# Copy this file to .env and fill in the values. This file is committed to
# git, so never put real passwords or keys here - real values go in .env only.
# python-decouple does NOT strip inline comments: keep comments on their own line.

# Django settings
# ENVIRONMENT: development, production or testing
ENVIRONMENT=development
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REPLACE_ME
DEBUG=True

# Database - PostgreSQL is required (no SQLite fallback)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sanoa
DB_USER=postgres
DB_PASSWORD=REPLACE_ME
DB_HOST=localhost
DB_PORT=5432

# Azure server: in the .env on the VM, point at the Azure database instead.
# If PostgreSQL runs on the same VM as the app, use DB_HOST=localhost and keep
# port 5432 closed to the internet.
# DB_NAME=apidb
# DB_USER=apiuser
# DB_PASSWORD=REPLACE_ME
# DB_HOST=localhost
# DB_PORT=5432

# Email - the console backend prints emails to the terminal in development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=REPLACE_ME
DEFAULT_FROM_EMAIL=noreply@sanoa.local

# Redis (cache + Celery)
REDIS_URL=redis://127.0.0.1:6379/1

# Paystack - TEST keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME
